# Copy to .env and fill in. Never commit .env.

# Token for the OpenClaw gateway / Control UI.
# Required: generate with `openssl rand -hex 32`.
OPENCLAW_GATEWAY_TOKEN=

# Optional: API keys for headless auth (otherwise log in interactively).
ANTHROPIC_API_KEY=
ANTIGRAVITY_API_KEY=

# Set to 1 to skip updating packages on start (first-time install still runs).
SKIP_UPDATE=0

# Space-separated global pnpm packages to install on the tools volume.
PNPM_GLOBAL_PACKAGES=openclaw @anthropic-ai/claude-code

# JSON array of origins allowed to open the Control UI (first start only).
OPENCLAW_CONTROL_UI_ORIGINS=["http://localhost:18789","http://127.0.0.1:18789"]
